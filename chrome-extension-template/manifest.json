{
  "manifest_version": 3,
  "name": "WorkMate Extension",
  "version": "1.0.0",
  "description": "Envoyer une page ou un texte vers WorkMate.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}